# Copy to .env and fill in real values. .env is git-ignored - never commit real credentials.

# --- PostgreSQL ---
DB_URL=jdbc:postgresql://localhost:5432/codeplatform
DB_USERNAME=postgres
DB_PASSWORD=

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MINUTES=1440
# Comma-separated usernames that receive the ADMIN role when they register.
ADMIN_USERNAMES=

# --- Frontend origin(s) allowed to call the API, comma separated ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- JDoodle code execution API (https://www.jdoodle.com/compiler-api) ---
JDOODLE_CLIENT_ID=
JDOODLE_CLIENT_SECRET=
